NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/batchops

# Comma-separated list of origins allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:5173

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Used by `npm run seed` to create the first admin account.
ADMIN_NAME=Vertical Lead
ADMIN_EMAIL=admin@batchops.dev
ADMIN_PASSWORD=ChangeMe@123

# Password-reset emails. Unset = no email; "forgot password" requests go to an admin instead.
#   log   -> print emails to this server's console (local development)
#   brevo -> send via Brevo's HTTPS API (free plan; verify MAIL_FROM_EMAIL as a sender in Brevo first)
# EMAIL_PROVIDER=log
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=you@gmail.com
# MAIL_FROM_NAME=BatchOps
# Public URL of the web app, used in emailed links (defaults to the first CLIENT_ORIGIN).
# APP_URL=http://localhost:5173

# Serve the built client (client/dist) from this server. Defaults to on whenever client/dist exists.
# SERVE_CLIENT=true
